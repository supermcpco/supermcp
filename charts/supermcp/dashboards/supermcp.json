{
  "title": "supermcp",
  "uid": "supermcp",
  "tags": [
    "supermcp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tool calls a second",
      "type": "timeseries",
      "description": "What the instance is actually doing. A drop to nothing with no deploy is the first thing to explain.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(supermcp_tool_calls_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Failures a second, by what failed",
      "type": "timeseries",
      "description": "upstream_4xx and upstream_5xx are somebody else's system. timeout, transform, config and policy are this one's.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (error_class) (rate(supermcp_tool_calls_total{status!=\"success\"}[5m]))",
          "legendFormat": "{{error_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Tool call latency",
      "type": "timeseries",
      "description": "End to end, including auth, transform and recording.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(supermcp_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(supermcp_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(supermcp_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Time spent waiting on the upstream",
      "type": "timeseries",
      "description": "When these two move together the problem is outside this system. When they diverge it is inside.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(supermcp_upstream_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 upstream",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(supermcp_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Surface build",
      "type": "timeseries",
      "description": "Assembling one caller's visible tools. It is cached for thirty seconds, so this is the cost of a miss.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(supermcp_surface_build_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "MCP requests by method",
      "type": "timeseries",
      "description": "tools/list against tools/call says whether clients are working or just looking.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(supermcp_mcp_requests_total[5m]))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Refusals",
      "type": "timeseries",
      "description": "401 and 403 climbing usually means a credential expired or a role changed, not an attack.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(supermcp_mcp_requests_total{code=~\"4..\"}[5m]))",
          "legendFormat": "mcp {{code}}",
          "refId": "A"
        },
        {
          "expr": "sum by (code) (rate(supermcp_http_requests_total{code=~\"4..\"}[5m]))",
          "legendFormat": "api {{code}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Connectors with an open breaker",
      "type": "timeseries",
      "description": "Calls being refused locally because the upstream was failing. It closes itself when the upstream recovers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(supermcp_breaker_state == 2)",
          "legendFormat": "open",
          "refId": "A"
        },
        {
          "expr": "sum(supermcp_breaker_state == 1)",
          "legendFormat": "half-open",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Audit queue",
      "type": "timeseries",
      "description": "Events queue before they are written, and a full queue drops them, which is a gap in the record. This one is worth waking someone.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(supermcp_audit_queue_depth)",
          "legendFormat": "waiting to be written",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Rate limiter",
      "type": "timeseries",
      "description": "1 means budgets are per replica, so the effective ceiling is lower and uneven.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max(supermcp_ratelimit_degraded)",
          "legendFormat": "degraded (Redis unreachable)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Master key calls",
      "type": "timeseries",
      "description": "Calls to the master key by outcome. With AWS KMS these are real KMS requests, made only when a data key is not already in memory, so errors here are calls something needed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(supermcp_kek_operations_total[5m]))",
          "legendFormat": "{{provider}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Audit export lag",
      "type": "timeseries",
      "description": "How old the oldest event is that a destination has not yet accepted, the worst of each kind. It climbs while a receiver refuses and falls back to zero once it catches up.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (kind) (supermcp_audit_export_lag_seconds)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Database pools",
      "type": "timeseries",
      "description": "Connections in use as a share of each pool's ceiling, busiest replica. Near one and staying there means requests are queueing for a connection.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (pool) (supermcp_db_pool_acquired_connections / supermcp_db_pool_max_connections)",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      }
    }
  ]
}
