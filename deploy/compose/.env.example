# Copy to .env and fill in. Never commit .env.

# Required. 32 random bytes, base64. Losing this key makes every stored
# credential unrecoverable; escrow it wherever you keep other secrets.
ENCRYPTION_KEK=

# Required. Database password for the bundled Postgres.
POSTGRES_PASSWORD=

# Externally visible URL. Must be https unless it points at localhost.
SUPERMCP_PUBLIC_URL=http://localhost:8080

# Bind address and port on the host.
SUPERMCP_BIND=127.0.0.1
SUPERMCP_PORT=8080

# Image tag to run.
SUPERMCP_VERSION=latest

# Only for the tls profile: docker compose --profile tls up
DOMAIN=

SUPERMCP_LOG_LEVEL=info
SUPERMCP_DEV=false
